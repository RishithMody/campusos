{
  "about": [
    "Renderer conformance corpus for any CampusOS Discord connector (T7c / case C9).",
    "Expected strings are written by hand from the nine-row template table in the",
    "ChannelSummary description of contracts/api.openapi.yaml -- not generated from",
    "our renderer, which would make the check circular.",
    "A connector conforms when, for every case, it produces exactly `expect_text`,",
    "or refuses to render when `expect_refused` is true. Byte equality, en dash and all."
  ],
  "cases": [
    {
      "id": "gathering-3",
      "summary": {"negotiation_id": "neg_1234567890abcdef", "status": "gathering", "round": 0, "max_rounds": 5, "template_id": "gathering_availability", "participant_count": 3},
      "expect_text": "Collecting availability from 3 people."
    },
    {
      "id": "gathering-2",
      "summary": {"negotiation_id": "neg_1234567890abcdef", "status": "gathering", "round": 0, "max_rounds": 20, "template_id": "gathering_availability", "participant_count": 2},
      "expect_text": "Collecting availability from 2 people."
    },
    {
      "id": "proposal-round-1",
      "summary": {"negotiation_id": "neg_1234567890abcdef", "status": "negotiating", "round": 1, "max_rounds": 5, "template_id": "proposal_on_table", "participant_count": 3},
      "expect_text": "There's a time on the table -- round 1 of 5."
    },
    {
      "id": "proposal-last-round",
      "summary": {"negotiation_id": "neg_1234567890abcdef", "status": "negotiating", "round": 5, "max_rounds": 5, "template_id": "proposal_on_table", "participant_count": 4},
      "expect_text": "There's a time on the table -- round 5 of 5."
    },
    {
      "id": "awaiting",
      "summary": {"negotiation_id": "neg_1234567890abcdef", "status": "awaiting_approval", "round": 2, "max_rounds": 5, "template_id": "awaiting_approvals", "participant_count": 3},
      "expect_text": "Waiting on everyone to confirm."
    },
    {
      "id": "converged-utc",
      "summary": {"negotiation_id": "neg_1234567890abcdef", "status": "converged", "round": 2, "max_rounds": 5, "template_id": "converged", "participant_count": 3, "timezone": "UTC", "agreed_slot": {"start": "2026-10-25T19:00:00Z", "end": "2026-10-25T20:00:00Z"}},
      "expect_text": "Locked in: 2026-10-25 19:00 UTC – 2026-10-25 20:00 UTC."
    },
    {
      "id": "converged-phoenix",
      "summary": {"negotiation_id": "neg_1234567890abcdef", "status": "converged", "round": 3, "max_rounds": 5, "template_id": "converged", "participant_count": 3, "timezone": "America/Phoenix", "agreed_slot": {"start": "2026-10-25T19:00:00Z", "end": "2026-10-25T20:00:00Z"}},
      "expect_text": "Locked in: 2026-10-25 12:00 MST – 2026-10-25 13:00 MST."
    },
    {
      "id": "failed-no-overlap",
      "summary": {"negotiation_id": "neg_1234567890abcdef", "status": "failed", "round": 3, "max_rounds": 5, "template_id": "failed_no_overlap", "participant_count": 3},
      "expect_text": "No time works for everyone in this window."
    },
    {
      "id": "failed-max-rounds",
      "summary": {"negotiation_id": "neg_1234567890abcdef", "status": "failed", "round": 5, "max_rounds": 5, "template_id": "failed_max_rounds", "participant_count": 3},
      "expect_text": "No time found in 5 rounds -- over to you."
    },
    {
      "id": "expired",
      "summary": {"negotiation_id": "neg_1234567890abcdef", "status": "expired", "round": 1, "max_rounds": 5, "template_id": "expired", "participant_count": 3},
      "expect_text": "This one timed out."
    },
    {
      "id": "cancelled",
      "summary": {"negotiation_id": "neg_1234567890abcdef", "status": "cancelled", "round": 1, "max_rounds": 5, "template_id": "cancelled", "participant_count": 3},
      "expect_text": "Someone withdrew, so this is off."
    },
    {
      "id": "consent-withdrawn-is-unreachable",
      "summary": {"negotiation_id": "neg_1234567890abcdef", "status": "cancelled", "round": 1, "max_rounds": 5, "template_id": "consent_withdrawn", "participant_count": 3},
      "expect_refused": true,
      "why": "The backend never emits this id: withdrawal is a uniform 403 and silence, never an announcement. It exists in the enum so neither side treats the list as open. A connector must refuse it rather than invent the sentence."
    }
  ]
}
