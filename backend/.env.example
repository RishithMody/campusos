CAMPUSOS_INFERENCE_MODE=mock
CAMPUSOS_DATABASE_URL=postgresql+psycopg://localhost/campusos
CAMPUSOS_REDIS_URL=redis://localhost:6379/0
# Set a randomly generated secret of at least 32 characters; never commit it.
CAMPUSOS_JWT_KEY=
# Only needed for vllm mode; private network /v1 endpoint, never a public URL.
CAMPUSOS_VLLM_URL=
CAMPUSOS_VLLM_KEY=
CAMPUSOS_VLLM_MODEL=
# Needed for real Discord channel verification; use a bot with Guild Members intent.
CAMPUSOS_DISCORD_TOKEN=
